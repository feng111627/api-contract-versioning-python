                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "邮箱。",
                "title": "Email"
              },
              "id": {
                "description": "用户 ID。",
                "title": "Id",
                "type": "integer"
              },
              "name": {
                "description": "姓名（单字段，v2 起拆分为 first_name/last_name）。",
                "title": "Name",
                "type": "string"
              }
