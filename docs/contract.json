{
  "service": {
    "name": "api-contract-versioning",
    "title": "API Contract Versioning"
  },
  "shared": {
    "error_codes": [
      {
        "code": "BAD_REQUEST",
        "http_status": 400,
        "message": "请求参数有误。"
      },
      {
        "code": "CONFLICT",
        "http_status": 409,
        "message": "请求与当前资源状态冲突。"
      },
      {
        "code": "INTERNAL_ERROR",
        "http_status": 500,
        "message": "服务内部错误，请稍后重试。"
      },
      {
        "code": "RATE_LIMITED",
        "http_status": 429,
        "message": "请求过于频繁，请稍后再试。"
      },
      {
        "code": "RESOURCE_NOT_FOUND",
        "http_status": 404,
        "message": "目标资源不存在。"
      },
      {
        "code": "VALIDATION_ERROR",
        "http_status": 422,
        "message": "请求参数校验失败。"
      },
      {
        "code": "VERSION_RETIRED",
        "http_status": 410,
        "message": "请求的接口版本已下线，请升级到推荐版本。"
      },
      {
        "code": "VERSION_UNKNOWN",
        "http_status": 404,
        "message": "请求的接口版本不存在。"
      }
    ],
    "error_response_schema": {
      "$defs": {
        "ErrorBody": {
          "description": "错误信封内层结构。",
          "properties": {
            "code": {
              "description": "稳定错误码，如 VALIDATION_ERROR。",
              "title": "Code",
              "type": "string"
            },
            "details": {
              "anyOf": [
                {
                  "items": {
                    "$ref": "#/$defs/ErrorDetail"
                  },
                  "type": "array"
                },
                {
                  "additionalProperties": true,
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "可选的字段级明细或补充信息；无补充时不出现。",
              "title": "Details"
            },
            "message": {
              "description": "面向调用方的错误说明，不包含内部细节。",
              "title": "Message",
              "type": "string"
            }
          },
          "required": [
            "code",
            "message"
          ],
          "title": "ErrorBody",
          "type": "object"
        },
        "ErrorDetail": {
          "description": "单条字段级错误明细。",
          "properties": {
            "field": {
              "description": "出错字段的位置，形如 user.email；根级错误为 (root)。",
              "title": "Field",
              "type": "string"
            },
            "issue": {
              "description": "该字段的问题描述（人类可读）。",
              "title": "Issue",
              "type": "string"
            }
          },
          "required": [
            "field",
            "issue"
          ],
          "title": "ErrorDetail",
          "type": "object"
        }
      },
      "description": "所有错误响应的统一顶层信封::\n\n{\"error\": {\"code\": \"...\", \"message\": \"...\", \"details\": [...]}}",
      "properties": {
        "error": {
          "$ref": "#/$defs/ErrorBody"
        }
      },
      "required": [
        "error"
      ],
      "title": "ErrorResponse",
      "type": "object"
    },
    "unknown_version_policy": {
      "error_code": "VERSION_UNKNOWN",
      "http_status": 404
    }
  },
  "versions": [
    {
      "endpoints": [],
      "retirement_policy": {
        "error_code": "VERSION_RETIRED",
        "http_status": 410
      },
      "version": {
        "deprecated_since": "2024-06-01",
        "introduced": "2023-01-01",
        "name": "v0",
        "notes": "最早版本，已停止服务，访问一律返回 410 VERSION_RETIRED。",
        "status": "retired",
        "successor": "v1",
        "sunset": "2025-01-01"
      }
    },
    {
