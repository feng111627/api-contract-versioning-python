          "request_schema": {
            "description": "创建用户请求（v2）。\n\n兼容期内同时接受拆分后的 first_name/last_name 与 v1 风格的 name；\n两者必须且只能提供一种。",
            "properties": {
              "email": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "deprecated": true,
                "title": "Email"
              },
              "first_name": {
                "anyOf": [
                  {
                    "maxLength": 50,
                    "minLength": 1,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "First Name"
              },
              "last_name": {
                "anyOf": [
                  {
                    "maxLength": 50,
                    "minLength": 1,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Last Name"
              },
              "name": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "deprecated": true,
                "description": "[已废弃] v1 风格完整姓名，仅兼容期可用；请改用 first_name/last_name。",
                "title": "Name"
              },
              "tier": {
                "default": "free",
                "pattern": "^(free|pro|enterprise)$",
                "title": "Tier",
                "type": "string"
              }
            },
            "title": "CreateUserV2Request",
            "type": "object"
          },
          "response_schema": {
            "description": "v2 用户视图。",
            "properties": {
              "email": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "deprecated": true,
                "description": "[已废弃] 邮箱字段，计划在 v3 移除；请改用联系方式接口。",
                "sunset": "2027-10-01",
                "title": "Email"
              },
              "first_name": {
                "description": "名。",
                "title": "First Name",
                "type": "string"
              },
              "id": {
                "description": "用户 ID。",
                "title": "Id",
                "type": "integer"
              },
              "last_name": {
                "description": "姓。",
                "title": "Last Name",
                "type": "string"
              },
              "tier": {
                "description": "会员等级：free / pro / enterprise。",
                "title": "Tier",
                "type": "string"
              }
            },
            "required": [
              "id",
              "first_name",
              "last_name",
              "tier"
            ],
            "title": "UserV2",
            "type": "object"
          },
          "summary": "创建用户（v2）"
        },
        {
